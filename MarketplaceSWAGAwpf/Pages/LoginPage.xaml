<Page x:Class="MarketplaceSWAGAwpf.Pages.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MarketplaceSWAGAwpf.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="LoginPage">
    <Grid Margin="30">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">
            <TextBlock Text="Вход в аккаунт" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <TextBlock Text="Логин" Margin="0,5"/>
            <TextBox x:Name="TBLogin" Height="35" Padding="5"/>

            <TextBlock Text="Пароль" Margin="0,10,0,5"/>
            <PasswordBox x:Name="PasswordBox" Height="35" Padding="5"/>

            <Button x:Name="BTNEnter" Content="Войти" Height="40" Margin="0,20,0,10" Click="BTNEnter_Click"/>
            <Button x:Name="BTNReg" Content="Создать аккаунт" Height="40" Margin="0,10" Click="BTNReg_Click"/>

            <TextBlock x:Name="TBError" Foreground="Red" HorizontalAlignment="Center" Margin="0,10,0,0"/>
        </StackPanel>
    </Grid>
</Page>
