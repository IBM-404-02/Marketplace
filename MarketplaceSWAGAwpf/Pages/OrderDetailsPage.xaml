<Page x:Class="MarketplaceSWAGAwpf.Pages.OrderDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MarketplaceSWAGAwpf.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="OrderDetailsPage">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock x:Name="TBTitle" FontSize="20" FontWeight="Bold"/>
            <TextBlock x:Name="TBDate" FontSize="14" Foreground="Gray" Margin="0,5"/>
            <TextBlock x:Name="TBStatus" FontSize="14" Foreground="Blue" Margin="0,5"/>
            <TextBlock x:Name="TBDelivery" FontSize="14" Margin="0,5"/>
        </StackPanel>

        <ListBox x:Name="LBItems" Grid.Row="1" ScrollViewer.VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,5" Padding="10" BorderThickness="1" BorderBrush="LightGray" Background="White">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding ProductName}" FontWeight="Bold" FontSize="14"/>
                                <TextBlock Text="{Binding Quantity, StringFormat='Количество: {0} шт.'}" FontSize="12" Foreground="Gray" Margin="0,5,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding PriceAtPurchase, StringFormat={}{0} ₽}" FontSize="14"/>
                                <TextBlock Text="{Binding Sum, StringFormat='Сумма: {0} ₽'}" FontSize="14" FontWeight="Bold" Foreground="Green" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Margin="0,15,0,0">
            <TextBlock x:Name="TBTotal" FontSize="18" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,0,0,10"/>
        </StackPanel>
    </Grid>
</Page>