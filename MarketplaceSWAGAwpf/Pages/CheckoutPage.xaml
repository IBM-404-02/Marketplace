<Page x:Class="MarketplaceSWAGAwpf.Pages.CheckoutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MarketplaceSWAGAwpf.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="CheckoutPage">

    <Grid Margin="30">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="400">
            <TextBlock Text="Оформление заказа" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <TextBlock x:Name="TBTotal" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <TextBlock Text="Выберите способ получения:" Margin="0,0,0,10"/>

            <RadioButton x:Name="RBPickup" Content="Самовывоз из ПВЗ" IsChecked="True" Margin="0,5" Checked="RBPickup_Checked"/>
            <RadioButton x:Name="RBDelivery" Content="Доставка курьером" Margin="0,5" Checked="RBDelivery_Checked"/>

            <TextBlock x:Name="TBDeliveryWarning" Foreground="Red" Text="Доставка недоступна при сумме заказа менее 600 ₽" Visibility="Collapsed" Margin="0,5"/>

            <StackPanel x:Name="PanelPickup" Margin="0,15,0,0">
                <TextBlock Text="Выберите пункт выдачи:" Margin="0,0,0,5"/>
                <ComboBox x:Name="CBPickupPoint" Height="35" Margin="0,0,0,10"/>
            </StackPanel>

            <StackPanel x:Name="PanelDelivery" Margin="0,15,0,0" Visibility="Collapsed">
                <TextBlock Text="Введите адрес доставки:" Margin="0,0,0,5"/>
                <TextBox x:Name="TBAddress" Height="35" Margin="0,0,0,10"/>
            </StackPanel>

            <Button x:Name="BTNCheckout" Content="Оформить заказ" Height="40" Margin="0,20,0,10" Click="BTNCheckout_Click"/>

            <TextBlock x:Name="TBError" Foreground="Red" HorizontalAlignment="Center" Margin="0,10,0,0"/>
        </StackPanel>
    </Grid>
</Page>
