<Page x:Class="MarketplaceSWAGAwpf.Pages.AddEditProductPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MarketplaceSWAGAwpf.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AddEditProductPage">
    <Grid Margin="20">
        <StackPanel Margin="20" Width="400" HorizontalAlignment="Center">
            <TextBlock x:Name="TitleText" Text="Добавить товар" FontSize="20" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center"/>

            <TextBlock Text="Название:"/>
            <TextBox x:Name="NameTextBox" Margin="0,0,0,10"/>

            <TextBlock Text="Описание:"/>
            <TextBox x:Name="DescriptionTextBox" Margin="0,0,0,10" Height="60" TextWrapping="Wrap"/>

            <TextBlock Text="Цена:"/>
            <TextBox x:Name="PriceTextBox" Margin="0,0,0,10"/>

            <TextBlock Text="Количество на складе:"/>
            <TextBox x:Name="StockTextBox" Margin="0,0,0,10"/>

            <TextBlock Text="Путь к изображению:"/>
            <TextBox x:Name="ImageTextBox" Margin="0,0,0,10"/>

            <TextBlock Text="Категория:"/>
            <ComboBox x:Name="CategoryComboBox" ItemsSource="{Binding Name}" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,0,0,10"/>

            <CheckBox x:Name="IsAvailableCheckBox" Content="Доступен для покупки" IsChecked="True" Margin="0,0,0,20"/>

            <TextBlock x:Name="ErrorText" Foreground="Red" Margin="0,0,0,10" TextWrapping="Wrap"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Сохранить" Width="120" Height="35" Click="Save_Click"/>
                <Button Content="Отмена" Width="120" Height="35" Background="LightGray" Click="Cancel_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
