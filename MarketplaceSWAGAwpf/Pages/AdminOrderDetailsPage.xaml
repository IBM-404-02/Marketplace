<Page x:Class="MarketplaceSWAGAwpf.Pages.AdminOrderDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MarketplaceSWAGAwpf.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AdminOrderDetailsPage">

    <StackPanel Margin="20" Width="700" HorizontalAlignment="Left">
        <TextBlock x:Name="TitleText" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>

        <TextBlock x:Name="CustomerText" FontSize="14" Margin="0,0,0,5"/>
        <TextBlock x:Name="StatusText" FontSize="14" Margin="0,0,0,5"/>
        <TextBlock x:Name="DeliveryText" FontSize="14" Margin="0,0,0,5"/>
        <TextBlock x:Name="TotalText" FontSize="14" FontWeight="Bold" Margin="0,0,0,20"/>

        <TextBlock Text="Состав заказа:" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
        <DataGrid x:Name="ItemsDataGrid" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="300" Margin="0,0,0,20">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Товар" Binding="{Binding ProductName}" Width="*"/>
                <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="80"/>
                <DataGridTextColumn Header="Цена" Binding="{Binding PriceAtPurchase, StringFormat={}{0:N2} ₽}" Width="100"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding Sum, StringFormat={}{0:N2} ₽}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Text="Изменить статус:" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
        <ComboBox x:Name="StatusComboBox" Width="300" Height="35" HorizontalAlignment="Left" Margin="0,0,0,15"/>

        <StackPanel Orientation="Horizontal">
            <Button Content="Сохранить статус" Width="180" Height="35" Background="Green" Foreground="White" Click="SaveStatus_Click"/>
        </StackPanel>

        <TextBlock x:Name="ErrorText" Foreground="Red" Margin="0,10,0,0" TextWrapping="Wrap"/>
    </StackPanel>
</Page>